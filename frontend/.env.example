# Application Configuration
VITE_APP_NAME=Your Application Name
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Your Application Description

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=10000

# Environment
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Storage Keys (for localStorage)
VITE_TOKEN_KEY=token
VITE_USER_KEY=user

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Session Configuration
VITE_SESSION_TIMEOUT=3600000
# Session timeout in milliseconds (1 hour = 3600000ms)

# Date Format
VITE_DATE_FORMAT=MM/DD/YYYY
VITE_TIME_FORMAT=HH:mm:ss
