{
  "expo": {
    "name": "Dr. Sanjay Patient Management",
    "slug": "patient-management-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#9333EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drsanjay.patientmanagement"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9333EA"
      },
      "package": "com.drsanjay.patientmanagement"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "APP_NAME": "Dr. Sanjay Patient Management",
      "APP_VERSION": "1.0.0",
      "APP_DESCRIPTION": "Professional Patient Management Mobile App",
      "API_URL": "http://192.168.1.6:5000/api",
      "API_TIMEOUT": "10000",
      "NODE_ENV": "development",
      "ENABLE_ANALYTICS": "false",
      "ENABLE_DEBUG": "true",
      "TOKEN_KEY": "@token",
      "USER_KEY": "@user",
      "DEFAULT_PAGE_SIZE": "10",
      "MAX_PAGE_SIZE": "100",
      "SESSION_TIMEOUT": "3600000"
    }
  }
}
